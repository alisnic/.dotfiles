{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/alisnic/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node /Users/alisnic/.claude/statusline.cjs",
    "padding": 0
  },
  "enabledPlugins": {
    "aiw@claudeai-seranking-common-lib-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {}
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "light",
  "editorMode": "normal",
  "verbose": false
}
